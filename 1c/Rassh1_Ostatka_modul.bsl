// =====================================================================================
// HTTP-servis Расш1_Ostatka (kengaytma MobilOstatka) — modul TO'LIQ.
// URL shablonlar (Шаблоны URL) va metodlar:
//   Search           : /search            GET  -> SearchGet
//   Skladlar         : /skladlar          GET  -> SkladlarGet
//   Tovar            : /tovar/{q}         GET  -> TovarGet          (?sklad=<id>&all=1)
//   Inv              : /inv               POST -> InvPost
//   Hujjatlar        : /hujjatlar         GET  -> HujjatlarGet
//   Hujjat           : /hujjat/{id}       GET  -> HujjatGet         (?q=qidiruv&f=new|diff)
//                                         POST -> HujjatPost
//   foydalanuvchilar : /foydalanuvchilar  GET  -> FoydalanuvchilarGet
//   Omborlar         : /omborlar          GET  -> OmborlarGet       (ko'chirish uchun omborlar)
//   Kochirish        : /kochirish         POST -> KochirishPost     (omborlar o'rtasida ko'chirish)
//   Qoldiq           : /qoldiq/{q}        GET  -> QoldiqGet         (?sklad=<id>, bo'lmasa barcha filiallar + filiallar ro'yxati)
//   Qoldiqlar        : /qoldiqlar/{id}    GET  -> QoldiqlarGet      (?seria=<id>, tovar omborlar kesimida)
//   Kirish           : /kirish            POST -> KirishPost        (xodim ismi + PIN, javobda sessiya tokeni)
//   Xodimlar         : /xodimlar          GET  -> XodimlarGet, POST -> XodimlarPost (faqat administrator)
//   Versiya          : /versiya           GET  -> VersiyaGet
//
// YANGI VERSIYA CHIQARGANDA: avval APK'ni serverga qo'ying, keyin НастройкиВерсии() da МинВерсия ni oshiring.
// =====================================================================================

Функция JsonОтвет(Данные, Код = 200)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция СкладПоИд(Ид)
	Тип = Метаданные.РегистрыНакопления.Остатки.Измерения.Склад.Тип.Типы()[0];
	Имя = Метаданные.НайтиПоТипу(Тип).Имя;
	Возврат Справочники[Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
КонецФункции

// Filial UUID -> ssilka (ombor kartochkasidagi "Филиал" rekvizit turi bo'yicha)
Функция ФилиалПоИд(Ид)
	Тип = Метаданные.Справочники.Складлар.Реквизиты.Филиал.Тип.Типы()[0];
	Имя = Метаданные.НайтиПоТипу(Тип).Имя;
	Возврат Справочники[Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
КонецФункции

// Foydalanuvchi filiali: avval Автор.Филиал, bo'lmasa asosiy ombor filiali
Функция ФилиалПользователя()
	Филиал = Неопределено;
	Нач = АсосийКассаВаСклад();
	Попытка
		Филиал = Нач.Автор.Филиал;
	Исключение
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(Филиал) Тогда
		Попытка
			Филиал = Нач.АсосийСклад.Филиал;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат Филиал;
КонецФункции

Функция УсловиеПоиска(З, Поле, Поиск)
	Текст = "";
	Слова = СтрРазделить(СокрЛП(?(Поиск = Неопределено, "", Поиск)), " ", Ложь);
	Н = 0;
	Для Каждого Слово Из Слова Цикл
		Н = Н + 1;
		Если Н > 6 Тогда
			Прервать;
		КонецЕсли;
		Слово = СтрЗаменить(Слово, "~", "~~");
		Слово = СтрЗаменить(Слово, "%", "~%");
		Слово = СтрЗаменить(Слово, "_", "~_");
		Слово = СтрЗаменить(Слово, "[", "~[");
		Слово = СтрЗаменить(Слово, "]", "~]");
		З.УстановитьПараметр("Слово" + Н, "%" + Слово + "%");
		Текст = Текст + " И " + Поле + " ПОДОБНО &Слово" + Н + " СПЕЦСИМВОЛ ""~""";
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция SearchGet(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Возврат Ответ;
КонецФункции

// ===================== KUNLIK SANOQ =====================

Функция SkladlarGet(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;

	Филиал = ФилиалПользователя();

	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	О.Склад КАК Склад,
	|	О.Склад.Наименование КАК Имя
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки() КАК О
	|ГДЕ
	|	О.СониОстаток <> 0
	|	И НЕ О.Склад.НеАктив
	|	И (&БезФилиала ИЛИ О.Склад.Филиал = &Филиал)
	|УПОРЯДОЧИТЬ ПО
	|	Имя";
	З.УстановитьПараметр("БезФилиала", НЕ ЗначениеЗаполнено(Филиал));
	З.УстановитьПараметр("Филиал", Филиал);

	Рез = Новый Массив;
	Выб = З.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Рез.Добавить(Новый Структура("id,name", XMLСтрока(Выб.Склад), Выб.Имя));
	КонецЦикла;
	Возврат JsonОтвет(Рез);
КонецФункции

Функция TovarGet(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок = Неопределено Тогда
		Блок = ПроверкаБулима(Запрос, "kunlik,ichki,otkazma");
	КонецЕсли;
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Поиск = Запрос.ПараметрыURL.Получить("q");
	СкладИд = Запрос.ПараметрыЗапроса.Получить("sklad");
	ВсеТовары = (Запрос.ПараметрыЗапроса.Получить("all") = "1");

	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 30
	|	Т.Ссылка КАК Товар,
	|	Т.Наименование КАК Имя,
	|	О.Серия КАК Серия,
	|	СУММА(ЕСТЬNULL(О.СониОстаток, 0)) КАК Учет
	|ИЗ
	|	Справочник.Товарлар КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Остатки.Остатки(&Период, Склад = &Склад) КАК О
	|		ПО О.Товар = Т.Ссылка
	|ГДЕ
	|	НЕ Т.ЭтоГруппа
	|	{ПОИСК}
	|СГРУППИРОВАТЬ ПО
	|	Т.Ссылка, Т.Наименование, О.Серия
	|ИМЕЮЩИЕ
	|	(&ВсеТовары ИЛИ СУММА(ЕСТЬNULL(О.СониОстаток, 0)) <> 0)
	|УПОРЯДОЧИТЬ ПО
	|	Имя";
	З.Текст = СтрЗаменить(З.Текст, "{ПОИСК}", УсловиеПоиска(З, "Т.Наименование", Поиск));
	З.УстановитьПараметр("Склад", СкладПоИд(СкладИд));
	З.УстановитьПараметр("Период", КонецДня(ТекущаяДата()));
	З.УстановитьПараметр("ВсеТовары", ВсеТовары);

	Рез = Новый Массив;
	Выб = З.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Э = Новый Структура;
		Э.Вставить("id", XMLСтрока(Выб.Товар));
		Э.Вставить("name", Выб.Имя);
		Э.Вставить("seria", ?(ЗначениеЗаполнено(Выб.Серия), XMLСтрока(Выб.Серия), ""));
		Э.Вставить("seria_name", ?(ЗначениеЗаполнено(Выб.Серия), Строка(Выб.Серия), ""));
		Э.Вставить("uchet", Выб.Учет);
		Рез.Добавить(Э);
	КонецЦикла;
	Возврат JsonОтвет(Рез);
КонецФункции

// Hujjatni YOZADI, O'TKAZMAYDI. Hisobchi 1C'da farqlarni ko'rib o'zi o'tkazadi.
Функция InvPost(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок = Неопределено Тогда
		Блок = ПроверкаБулима(Запрос, "kunlik");
	КонецЕсли;
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Попытка
		Чт = Новый ЧтениеJSON;
		Чт.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
		Данные = ПрочитатьJSON(Чт, Истина);
		Склад = СкладПоИд(Данные["sklad"]);

		Док = Документы.ОстаткаНиТугирлаш.СоздатьДокумент();
		Док.Дата = ТекущаяДата();
		Док.Склад = Склад;
		Попытка
			Док.Филиал = Склад.Филиал;
		Исключение
		КонецПопытки;
		Попытка
			ОбщийМодульДляПодпискаНаСобытие.ЗаполнитьОрганизация(Док);
		Исключение
		КонецПопытки;
		Нач = АсосийКассаВаСклад();
		Если Нач.АвтоКурс Тогда
			Док.Курс = ОхиргиКурс(КонецДня(Док.Дата), Справочники.Валюта.Доллар, 1);
		КонецЕсли;
		Док.Автор = Нач.Автор;
		Док.Изох = "Mobil ilova: Kunlik sanoq" + ТекстХодима(ИмяХодима(Запрос));

		Для Каждого С Из Данные["items"] Цикл
			Товар = Справочники.Товарлар.ПолучитьСсылку(Новый УникальныйИдентификатор(С["id"]));
			Серия = ?(ПустаяСтрока(С["seria"]),
				Справочники.ТоварСериялари.ПустаяСсылка(),
				Справочники.ТоварСериялари.ПолучитьСсылку(Новый УникальныйИдентификатор(С["seria"])));
			Факт = С["fakt"];
			Ост = СерверныеМеханизмы2.ОстаткаУчетКорДона(Док.Дата, Товар, Склад, Серия, Док.Организация);
			Упк = СерверныеМеханизмы2.ПолучитьУпкСони(Товар);
			// "Baza" soni — sanoq paytida ilovada ko'rsatilgan qoldiq ("uchet"). Yuborilmasa (eski ilova) — hozirgi qoldiq.
			Учет = С["uchet"];
			Если Учет = Неопределено Тогда
				Учет = Ост.Сони;
			КонецЕсли;

			Стр = Док.Товарлар.Добавить();
			Стр.Товар = Товар;
			Стр.Серия = Серия;
			Стр.СониОстатка = Учет;
			Если Учет = Ост.Сони Тогда
				Стр.КорОстатка = Ост.Кор;
				Стр.ДонаОстатка = Ост.Дона;
			ИначеЕсли Упк <> 0 Тогда
				Стр.КорОстатка = Цел(Учет / Упк);
				Стр.ДонаОстатка = Учет - Стр.КорОстатка * Упк;
			Иначе
				Стр.КорОстатка = 0;
				Стр.ДонаОстатка = Учет;
			КонецЕсли;
			Стр.СониОстаткаФакт = Факт;
			Стр.Сони = Факт - Учет;
			Если Ост.УчетКорДона И Упк <> 0 Тогда
				Стр.КорОстаткаФакт = Цел(Факт / Упк);
				Стр.ДонаОстаткаФакт = Факт - Стр.КорОстаткаФакт * Упк;
				Стр.Кор = Цел(Стр.Сони / Упк);
				Стр.Дона = Стр.Сони - Стр.Кор * Упк;
			КонецЕсли;
			Если Стр.Сони > 0 Тогда
				Стр.Нархи = Ост.ОстаткаНархи;
				Стр.Сумма = Стр.Сони * Стр.Нархи;
			КонецЕсли;
		КонецЦикла;

		Док.Записать(РежимЗаписиДокумента.Запись);
		Ключи = Новый Массив;
		Для Каждого Стр Из Док.Товарлар Цикл
			Ключи.Добавить(КлючСтрокиДок(Стр.Товар, Стр.Серия));
		КонецЦикла;
		СаналганларДобавить(Док.Ссылка, Ключи);
		ТарихАмал(Запрос, "kunlik", "Kunlik sanoq 1C'ga yuborildi: " + СокрЛП(Строка(Склад)) + " — " + Чис(Док.Товарлар.Количество()) + " ta farqli tovar", СокрЛП(Док.Номер));
		Возврат JsonОтвет(Новый Структура("ok,nomer", Истина, Строка(Док.Номер)));
	Исключение
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, ОписаниеОшибки()), 500);
	КонецПопытки;
КонецФункции

// ===================== ICHKI SANOQ (ОстаткаНиТугирлаш hujjatlari) =====================

// Qatorni faktga qarab qayta hisoblaydi (formadagi mantiq bilan bir xil).
// Kor/Dona (quti/dona) hisobi ОстаткаУчетКорДона'dan olinadi;
// funksional opsiya bazada bo'lmasa ham xato bermaydi.
Процедура ПересчитатьСтроку(Док, Стр, Факт)
	Ост = СерверныеМеханизмы2.ОстаткаУчетКорДона(Док.Дата, Стр.Товар, Док.Склад, Стр.Серия, Док.Организация);
	Упк = СерверныеМеханизмы2.ПолучитьУпкСони(Стр.Товар);

	УчетКД = Ложь;
	Попытка
		УчетКД = Ост.УчетКорДона;
	Исключение
	КонецПопытки;
	Если НЕ УчетКД Тогда
		Попытка
			УчетКД = ПолучитьФункциональнуюОпцию("УчетКорДона");
		Исключение
		КонецПопытки;
	КонецЕсли;

	Стр.СониОстаткаФакт = Факт;
	Стр.Сони = Факт - Стр.СониОстатка;
	Если УчетКД И Упк <> 0 Тогда
		Стр.КорОстаткаФакт = Цел(Факт / Упк);
		Стр.ДонаОстаткаФакт = Факт - Стр.КорОстаткаФакт * Упк;
		Стр.Кор = Цел(Стр.Сони / Упк);
		Стр.Дона = Стр.Сони - Стр.Кор * Упк;
	КонецЕсли;
	Если Стр.Сони > 0 Тогда
		Стр.Нархи = Ост.ОстаткаНархи;
		Стр.Сумма = Стр.Сони * Стр.Нархи;
	Иначе
		Стр.Нархи = 0;
		Стр.Сумма = 0;
	КонецЕсли;
КонецПроцедуры

// ---- Ichki sanoq: ilovada sanalgan qatorlar ----
// 1C hujjatida "hali sanalmagan" va "fakt 0 deb sanalgan" qatorlar farqlanmaydi: ikkalasida СониОстаткаФакт = 0,
// Сони (farq) esa −qoldiq. Shuning uchun ilova orqali fakt yozilgan qatorlar alohida eslab qolinadi:
// ХранилищеОбщихНастроек("MobilOstatka.Sanaldi", <hujjat UUID>) = Соответствие "товар UUID|серия UUID" -> Истина.
// Qator SANALGAN: fakt 0 dan farqli (1C'da yozilgan bo'lsa ham) YOKI ilovadan yozilgan.
// FARQLI: sanalgan va fakt ≠ qoldiq.
Функция СаналганларПрочитать(Ссылка)
	УстановитьПривилегированныйРежим(Истина);
	С = ХранилищеОбщихНастроек.Загрузить("MobilOstatka.Sanaldi", XMLСтрока(Ссылка), , "MobilOstatka");
	Возврат ?(ТипЗнч(С) = Тип("Соответствие"), С, Новый Соответствие);
КонецФункции

Процедура СаналганларДобавить(Ссылка, Ключи)
	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		С = СаналганларПрочитать(Ссылка);
		Для Каждого К Из Ключи Цикл
			С.Вставить(К, Истина);
		КонецЦикла;
		ХранилищеОбщихНастроек.Сохранить("MobilOstatka.Sanaldi", XMLСтрока(Ссылка), С, , "MobilOstatka");
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура СаналганларУдалить(Ссылка)
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ХранилищеОбщихНастроек.Удалить("MobilOstatka.Sanaldi", XMLСтрока(Ссылка), "MobilOstatka");
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция КлючСтрокиДок(Товар, Серия)
	Возврат XMLСтрока(Товар) + "|" + ?(ЗначениеЗаполнено(Серия), XMLСтрока(Серия), "");
КонецФункции

Функция HujjatlarGet(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок = Неопределено Тогда
		Блок = ПроверкаБулима(Запрос, "ichki");
	КонецЕсли;
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Филиал = ФилиалПользователя();
	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	Д.Ссылка КАК Док,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Склад.Наименование КАК СкладИмя,
	|	КОЛИЧЕСТВО(Т.НомерСтроки) КАК Всего,
	|	СУММА(ВЫБОР КОГДА Т.СониОстаткаФакт <> 0 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Готово
	|ИЗ
	|	Документ.ОстаткаНиТугирлаш КАК Д
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОстаткаНиТугирлаш.Товарлар КАК Т
	|		ПО Т.Ссылка = Д.Ссылка
	|ГДЕ
	|	НЕ Д.Проведен
	|	И НЕ Д.ПометкаУдаления
	|	И (&БезФилиала ИЛИ Д.Филиал = &Филиал)
	|СГРУППИРОВАТЬ ПО
	|	Д.Ссылка, Д.Номер, Д.Дата, Д.Склад.Наименование
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата УБЫВ";
	З.УстановитьПараметр("БезФилиала", НЕ ЗначениеЗаполнено(Филиал));
	З.УстановитьПараметр("Филиал", Филиал);
	Рез = Новый Массив;
	Выб = З.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Э = Новый Структура;
		Э.Вставить("id", XMLСтрока(Выб.Док));
		Э.Вставить("nomer", ?(Выб.Номер = Null, "", СокрЛП(Выб.Номер)));
		Э.Вставить("sana", ?(Выб.Дата = Null, "", Формат(Выб.Дата, "ДФ=dd.MM.yyyy")));
		Э.Вставить("sklad", ?(Выб.СкладИмя = Null, "", Выб.СкладИмя));
		Э.Вставить("jami", ?(Выб.Всего = Null, 0, Выб.Всего));
		Готово = ?(Выб.Готово = Null, 0, Выб.Готово);
		// fakt 0 bilan ilovadan sanalgan qatorlar ham "sanalgan"
		С = СаналганларПрочитать(Выб.Док);
		Если С.Количество() > 0 Тогда
			Н = Новый Запрос;
			Н.Текст =
			"ВЫБРАТЬ
			|	Т.Товар КАК Товар,
			|	Т.Серия КАК Серия
			|ИЗ
			|	Документ.ОстаткаНиТугирлаш.Товарлар КАК Т
			|ГДЕ
			|	Т.Ссылка = &Док
			|	И Т.СониОстаткаФакт = 0";
			Н.УстановитьПараметр("Док", Выб.Док);
			В = Н.Выполнить().Выбрать();
			Пока В.Следующий() Цикл
				Если С[КлючСтрокиДок(В.Товар, В.Серия)] = Истина Тогда
					Готово = Готово + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Э.Вставить("tayyor", Готово);
		Рез.Добавить(Э);
	КонецЦикла;
	Возврат JsonОтвет(Рез);
КонецФункции

Функция HujjatGet(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок = Неопределено Тогда
		Блок = ПроверкаБулима(Запрос, "ichki");
	КонецЕсли;
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Ссылка = Документы.ОстаткаНиТугирлаш.ПолучитьСсылку(Новый УникальныйИдентификатор(Запрос.ПараметрыURL.Получить("id")));
	Поиск = Запрос.ПараметрыЗапроса.Получить("q");

	Режим = 0;
	Ф = Запрос.ПараметрыЗапроса.Получить("f");
	Если Ф = "new" Тогда
		Режим = 1;
	ИначеЕсли Ф = "diff" Тогда
		Режим = 2;
	КонецЕсли;

	Санал = СаналганларПрочитать(Ссылка);

	// Hisoblagichlar — butun hujjat bo'yicha (qidiruvdan qat'i nazar)
	С = Новый Запрос;
	С.Текст =
	"ВЫБРАТЬ
	|	Т.Товар КАК Товар,
	|	Т.Серия КАК Серия,
	|	Т.СониОстатка КАК Учет,
	|	Т.СониОстаткаФакт КАК Факт
	|ИЗ
	|	Документ.ОстаткаНиТугирлаш.Товарлар КАК Т
	|ГДЕ
	|	Т.Ссылка = &Док";
	С.УстановитьПараметр("Док", Ссылка);
	Всего = 0;
	Нет = 0;
	Разн = 0;
	В = С.Выполнить().Выбрать();
	Пока В.Следующий() Цикл
		Всего = Всего + 1;
		Сан = В.Факт <> 0 ИЛИ Санал[КлючСтрокиДок(В.Товар, В.Серия)] = Истина;
		Если НЕ Сан Тогда
			Нет = Нет + 1;
		ИначеЕсли В.Факт <> В.Учет Тогда
			Разн = Разн + 1;
		КонецЕсли;
	КонецЦикла;

	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ
	|	Т.Товар КАК Товар,
	|	Т.Товар.Наименование КАК Имя,
	|	Т.Серия КАК Серия,
	|	Т.СониОстатка КАК Учет,
	|	Т.СониОстаткаФакт КАК Факт
	|ИЗ
	|	Документ.ОстаткаНиТугирлаш.Товарлар КАК Т
	|ГДЕ
	|	Т.Ссылка = &Док
	|	{ПОИСК}
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки";
	З.Текст = СтрЗаменить(З.Текст, "{ПОИСК}", УсловиеПоиска(З, "Т.Товар.Наименование", Поиск));
	З.УстановитьПараметр("Док", Ссылка);
	Рез = Новый Массив;
	Выб = З.Выполнить().Выбрать();
	Пока Выб.Следующий() И Рез.Количество() < 50 Цикл
		Сан = Выб.Факт <> 0 ИЛИ Санал[КлючСтрокиДок(Выб.Товар, Выб.Серия)] = Истина;
		Если Режим = 1 И Сан ИЛИ Режим = 2 И НЕ (Сан И Выб.Факт <> Выб.Учет) Тогда
			Продолжить;
		КонецЕсли;
		Э = Новый Структура;
		Э.Вставить("id", XMLСтрока(Выб.Товар));
		Э.Вставить("name", Выб.Имя);
		Э.Вставить("seria", ?(ЗначениеЗаполнено(Выб.Серия), XMLСтрока(Выб.Серия), ""));
		Э.Вставить("seria_name", ?(ЗначениеЗаполнено(Выб.Серия), Строка(Выб.Серия), ""));
		Э.Вставить("uchet", Выб.Учет);
		Э.Вставить("fakt", Выб.Факт);
		Э.Вставить("sanalgan", Сан);
		Рез.Добавить(Э);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("proveden", Ссылка.Проведен);
	Результат.Вставить("sklad", XMLСтрока(Ссылка.Склад));
	Результат.Вставить("counts", Новый Структура("jami,sanalmagan,farqli", Всего, Нет, Разн));
	Результат.Вставить("rows", Рез);
	Возврат JsonОтвет(Результат);
КонецФункции

// Oddiy so'rov:  {"items":[{id,seria,fakt,add}]}               -> faqat faktni yozadi, O'TKAZMAYDI
// "Yakunlash":   {"items":[{id,seria,fakt,add}], "post":true}  -> yozadi va hujjatni O'TKAZADI (Провести)
// add=1 bo'lsa va tovar hujjatda yo'q bo'lsa, hujjatga yangi qator qo'shiladi.
// Yuborilgan qatorda Учет = 0 va fakt = 0 bo'lsa, qator hujjatdan o'chiriladi (javobda "deleted").
Функция HujjatPost(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок = Неопределено Тогда
		Блок = ПроверкаБулима(Запрос, "ichki");
	КонецЕсли;
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Попытка
		Чт = Новый ЧтениеJSON;
		Чт.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
		Данные = ПрочитатьJSON(Чт, Истина);
		Док = Документы.ОстаткаНиТугирлаш.ПолучитьСсылку(Новый УникальныйИдентификатор(Запрос.ПараметрыURL.Получить("id"))).ПолучитьОбъект();
		Если Док = Неопределено Тогда
			Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "Hujjat topilmadi"), 404);
		КонецЕсли;
		Если Док.Проведен Тогда
			Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "Hujjat 1C'da allaqachon o'tkazilgan"), 409);
		КонецЕсли;

		Обновлено = 0;
		НеНайдено = 0;
		// Учет = 0 va fakt = 0 bo'lgan qatorlar hujjatdan o'chiriladi
		КУдалению = Новый Массив;
		Удаленные = Новый Соответствие;
		Если Данные["items"] <> Неопределено Тогда
			Для Каждого С Из Данные["items"] Цикл
				Товар = Справочники.Товарлар.ПолучитьСсылку(Новый УникальныйИдентификатор(С["id"]));
				Серия = ?(ПустаяСтрока(С["seria"]),
					Справочники.ТоварСериялари.ПустаяСсылка(),
					Справочники.ТоварСериялари.ПолучитьСсылку(Новый УникальныйИдентификатор(С["seria"])));
				Найд = Док.Товарлар.НайтиСтроки(Новый Структура("Товар,Серия", Товар, Серия));
				Если Найд.Количество() > 0 Тогда
					Стр = Найд[0];
				ИначеЕсли С["add"] = 1 Тогда
					Ост = СерверныеМеханизмы2.ОстаткаУчетКорДона(Док.Дата, Товар, Док.Склад, Серия, Док.Организация);
					Стр = Док.Товарлар.Добавить();
					Стр.Товар = Товар;
					Стр.Серия = Серия;
					Стр.КорОстатка = Ост.Кор;
					Стр.ДонаОстатка = Ост.Дона;
					Стр.СониОстатка = Ост.Сони;
				Иначе
					НеНайдено = НеНайдено + 1;
					Продолжить;
				КонецЕсли;
				ПересчитатьСтроку(Док, Стр, С["fakt"]);
				Обновлено = Обновлено + 1;
				Если Стр.СониОстатка = 0 И Стр.СониОстаткаФакт = 0 Тогда
					Если КУдалению.Найти(Стр) = Неопределено Тогда
						КУдалению.Добавить(Стр);
					КонецЕсли;
					Удаленные.Вставить(С["id"] + "|" + С["seria"], Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Для Каждого Стр Из КУдалению Цикл
			Док.Товарлар.Удалить(Стр);
		КонецЦикла;

		Проводить = (Данные["post"] = Истина);
		// Ilovadan fakt yozilgan qatorlar (o'chirilganlardan tashqari) — "sanalgan"
		Ключи = Новый Массив;
		Если Данные["items"] <> Неопределено Тогда
			Для Каждого С Из Данные["items"] Цикл
				К = С["id"] + "|" + С["seria"];
				Если Удаленные[К] <> Истина Тогда
					Ключи.Добавить(К);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Проводить Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
			СаналганларУдалить(Док.Ссылка);
			ТарихАмал(Запрос, "ichki", "Ichki sanoq 1C'da o'tkazildi: " + СокрЛП(Строка(Док.Склад)), СокрЛП(Док.Номер));
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
			СаналганларДобавить(Док.Ссылка, Ключи);
			ТарихАмал(Запрос, "ichki", "Ichki sanoq saqlandi: " + СокрЛП(Строка(Док.Склад)) + " — " + Чис(Обновлено) + " ta tovar"
				+ ?(КУдалению.Количество() > 0, ", " + Чис(КУдалению.Количество()) + " ta bo'sh qator o'chirildi", ""), СокрЛП(Док.Номер));
		КонецЕсли;

		// TEKSHIRUV: bazaga haqiqatan yozilganini qayta o'qib solishtiramiz
		Пров = Новый Запрос;
		Пров.Текст =
		"ВЫБРАТЬ
		|	Т.Товар КАК Товар,
		|	Т.Товар.Наименование КАК Имя,
		|	Т.Серия КАК Серия,
		|	Т.СониОстаткаФакт КАК Факт
		|ИЗ
		|	Документ.ОстаткаНиТугирлаш.Товарлар КАК Т
		|ГДЕ
		|	Т.Ссылка = &Док";
		Пров.УстановитьПараметр("Док", Док.Ссылка);
		ТЗ = Пров.Выполнить().Выгрузить();
		Farqlar = Новый Массив;
		Если Данные["items"] <> Неопределено Тогда
			Для Каждого С Из Данные["items"] Цикл
				Если Удаленные[С["id"] + "|" + С["seria"]] = Истина Тогда
					Продолжить;
				КонецЕсли;
				Товар = Справочники.Товарлар.ПолучитьСсылку(Новый УникальныйИдентификатор(С["id"]));
				Серия = ?(ПустаяСтрока(С["seria"]),
					Справочники.ТоварСериялари.ПустаяСсылка(),
					Справочники.ТоварСериялари.ПолучитьСсылку(Новый УникальныйИдентификатор(С["seria"])));
				Найд = ТЗ.НайтиСтроки(Новый Структура("Товар,Серия", Товар, Серия));
				Если Найд.Количество() = 0 Тогда
					Farqlar.Добавить(Новый Структура("name,yuborildi,bazada", Строка(Товар), С["fakt"], "qator yo'q"));
				ИначеЕсли Найд[0].Факт <> С["fakt"] Тогда
					Farqlar.Добавить(Новый Структура("name,yuborildi,bazada", Найд[0].Имя, С["fakt"], Найд[0].Факт));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Ответ = Новый Структура;
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("updated", Обновлено);
		Ответ.Вставить("missing", НеНайдено);
		Ответ.Вставить("posted", Проводить);
		Ответ.Вставить("nomer", СокрЛП(Док.Номер));
		Ответ.Вставить("farqlar", Farqlar);
		// O'chirilgan qatorlar kalitlari ("id|seria"), ilova ularni ro'yxatdan olib tashlaydi
		Удалено = Новый Массив;
		Для Каждого КЗ Из Удаленные Цикл
			Удалено.Добавить(КЗ.Ключ);
		КонецЦикла;
		Ответ.Вставить("deleted", Удалено);
		Возврат JsonОтвет(Ответ);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Текст = "";
		Пока Инфо <> Неопределено Цикл
			Текст = Текст + Инфо.Описание + " | ";
			Инфо = Инфо.Причина;
		КонецЦикла;
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, Текст), 500);
	КонецПопытки;
КонецФункции

// ===================== OMBORLAR O'RTASIDA KO'CHIRISH (СкладларУртасидаУтказиш) =====================

// Foydalanuvchi filialidagi barcha faol omborlar (qoldig'i bo'lmasa ham; o'chirishga belgilangan va НеАктив — yo'q).
// Boshqa omborlar uchun tranzit bo'lgan omborlar ham chiqadi (masalan VITRINA, Brak — ular ishchi omborlar).
Функция OmborlarGet(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок = Неопределено Тогда
		Блок = ПроверкаБулима(Запрос, "otkazma,qoldiq");
	КонецЕсли;
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Филиал = ФилиалПользователя();
	// ?filiallar=1 — Qoldiqlar filtri uchun: faol ombori bor BARCHA filiallar (o'z filiali birinchi)
	Если Запрос.ПараметрыЗапроса.Получить("filiallar") = "1" Тогда
		Ф = Новый Запрос;
		Ф.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	С.Филиал КАК Филиал,
		|	С.Филиал.Наименование КАК Имя
		|ИЗ
		|	Справочник.Складлар КАК С
		|ГДЕ
		|	НЕ С.ПометкаУдаления
		|	И НЕ С.НеАктив
		|УПОРЯДОЧИТЬ ПО
		|	Имя";
		Рез = Новый Массив;
		Выб = Ф.Выполнить().Выбрать();
		Пока Выб.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(Выб.Филиал) Тогда
				Продолжить;
			КонецЕсли;
			Э = Новый Структура("id,name,meniki", XMLСтрока(Выб.Филиал), Выб.Имя, ЗначениеЗаполнено(Филиал) И Выб.Филиал = Филиал);
			Если Э.meniki Тогда
				Рез.Вставить(0, Э);
			Иначе
				Рез.Добавить(Э);
			КонецЕсли;
		КонецЦикла;
		Возврат JsonОтвет(Рез);
	КонецЕсли;
	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ
	|	С.Ссылка КАК Склад,
	|	С.Наименование КАК Имя,
	|	С.ТранзитныйСклад <> ЗНАЧЕНИЕ(Справочник.Складлар.ПустаяСсылка) КАК Транзит
	|ИЗ
	|	Справочник.Складлар КАК С
	|ГДЕ
	|	НЕ С.ПометкаУдаления
	|	И НЕ С.НеАктив
	|	И (&БезФилиала ИЛИ С.Филиал = &Филиал)
	|УПОРЯДОЧИТЬ ПО
	|	Имя";
	З.УстановитьПараметр("БезФилиала", НЕ ЗначениеЗаполнено(Филиал));
	З.УстановитьПараметр("Филиал", Филиал);
	Рез = Новый Массив;
	Выб = З.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Рез.Добавить(Новый Структура("id,name,tranzit", XMLСтрока(Выб.Склад), Выб.Имя, Выб.Транзит));
	КонецЦикла;
	Возврат JsonОтвет(Рез);
КонецФункции

// {"uid":"...", "from":<ombor id>, "to":<ombor id>, "items":[{id, seria, soni}]}
// Hujjat yoziladi va DARHOL O'TKAZILADI. Qoldiq yetmasa hech narsa yozilmaydi.
// Bir xil uid bilan qayta yuborilsa (internet uzilib qolsa), yangi hujjat yaratilmaydi — avvalgisi qaytariladi.
Функция KochirishPost(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок = Неопределено Тогда
		Блок = ПроверкаБулима(Запрос, "otkazma");
	КонецЕсли;
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Попытка
		Чт = Новый ЧтениеJSON;
		Чт.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
		Данные = ПрочитатьJSON(Чт, Истина);
	Исключение
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "So'rov noto'g'ri: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())), 400);
	КонецПопытки;
	Данные.Вставить("xodim", ИмяХодима(Запрос));
	Р = Кочирить(Данные);
	Если Р.Данные.Свойство("nomer") И НЕ Р.Данные.Свойство("repeat") Тогда
		Попытка
			Сони = Данные["items"].Количество();
		Исключение
			Сони = 0;
		КонецПопытки;
		ТарихАмал(Запрос, "otkazma", "O'tkazma: " + СокрЛП(Строка(СкладПоИд(Данные["from"]))) + " → " + СокрЛП(Строка(СкладПоИд(Данные["to"])))
			+ " — " + Чис(Сони) + " ta tovar", Р.Данные.nomer);
	КонецЕсли;
	Возврат JsonОтвет(Р.Данные, Р.Код);
КонецФункции

Функция РезКочирить(Данные, Код = 200)
	Возврат Новый Структура("Код,Данные", Код, Данные);
КонецФункции

// Shu uid bilan avval o'tkazilgan hujjat (o'tkazilgan va o'chirishga belgilanmagan) yoki Неопределено
Функция ОтказмаПоUID(UID)
	УстановитьПривилегированныйРежим(Истина);
	Ид = ХранилищеОбщихНастроек.Загрузить("MobilOstatka.Otkazma", UID, , "MobilOstatka");
	Если ТипЗнч(Ид) <> Тип("Строка") ИЛИ ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Документы.СкладларУртасидаУтказиш.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
		Если Ссылка.ПолучитьОбъект() <> Неопределено И Ссылка.Проведен И НЕ Ссылка.ПометкаУдаления Тогда
			Возврат Новый Структура("Номер", Ссылка.Номер);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// Ko'chirish mantig'i (HTTP'siz, test bazadan to'g'ridan-to'g'ri chaqirish mumkin). Natija: {Код, Данные}
Функция Кочирить(Данные)
	Попытка
		// Izoh: "Mobil ilova: o'tkazma — <Xodim>". uid izohga yozilmaydi: takroriy yuborishdan himoya uchun
		// uid → hujjat bog'lanishi umumiy sozlamalar xotirasida saqlanadi (ОтказмаПоUID).
		UID = СокрЛП(Строка(Данные["uid"]));
		Метка = "Mobil ilova: o'tkazma";
		Если ЗначениеЗаполнено(UID) Тогда
			Был = ОтказмаПоUID(UID);
			Если Был <> Неопределено Тогда
				Возврат РезКочирить(Новый Структура("ok,nomer,repeat", Истина, СокрЛП(Был.Номер), Истина));
			КонецЕсли;
		КонецЕсли;

		Откуда = СкладПоИд(Данные["from"]);
		Куда = СкладПоИд(Данные["to"]);
		Если Откуда.Пустая() ИЛИ Куда.Пустая() Тогда
			Возврат РезКочирить(Новый Структура("ok,error", Ложь, "Omborlar tanlanmagan."), 409);
		КонецЕсли;
		Если Откуда = Куда Тогда
			Возврат РезКочирить(Новый Структура("ok,error", Ложь, "Jo'natuvchi va qabul qiluvchi ombor bir xil bo'lishi mumkin emas."), 409);
		КонецЕсли;
		Филиал = ФилиалПользователя();
		Если ЗначениеЗаполнено(Филиал) И (Откуда.Филиал <> Филиал ИЛИ Куда.Филиал <> Филиал) Тогда
			Возврат РезКочирить(Новый Структура("ok,error", Ложь, "Faqat o'z filialingiz omborlari o'rtasida ko'chirish mumkin."), 409);
		КонецЕсли;
		Если Данные["items"] = Неопределено ИЛИ Данные["items"].Количество() = 0 Тогда
			Возврат РезКочирить(Новый Структура("ok,error", Ложь, "Ko'chiriladigan tovar yo'q."), 409);
		КонецЕсли;

		Док = Документы.СкладларУртасидаУтказиш.СоздатьДокумент();
		Док.Дата = ТекущаяДата();
		Попытка
			ОбщийМодульДляПодпискаНаСобытие.ЗаполнитьОрганизация(Док);
		Исключение
		КонецПопытки;
		Нач = АсосийКассаВаСклад();
		Попытка
			Док.Автор = ПараметрыСеанса.ТекущийПользователь;
		Исключение
			Док.Автор = Нач.Автор;
		КонецПопытки;
		Попытка
			Док.НархТури = Нач.АсосийНархТури;
		Исключение
		КонецПопытки;
		Док.СкладУтказувчи = Откуда;
		Док.СкладКабулКилувчи = Куда;
		Док.Филиал = Откуда.Филиал;
		Док.ФилиалКабулКилувчи = Куда.Филиал;
		Док.Изох = Метка + ТекстХодима(Данные["xodim"]);
		// «Товар кабул килинди» ilovadan HECH QACHON qo'yilmaydi: hujjat o'tkaziladi, qabul qiluvchi
		// ombor tovarni 1C'da o'zi qabul qiladi (tranzit ombori bo'lsa, tovar avval tranzitga tushadi).
		Док.ТоварКабулКилинди = Ложь;

		Ошибки = Новый Массив;
		Всего = 0;
		Для Каждого С Из Данные["items"] Цикл
			Товар = Справочники.Товарлар.ПолучитьСсылку(Новый УникальныйИдентификатор(С["id"]));
			Серия = ?(ПустаяСтрока(С["seria"]),
				Справочники.ТоварСериялари.ПустаяСсылка(),
				Справочники.ТоварСериялари.ПолучитьСсылку(Новый УникальныйИдентификатор(С["seria"])));
			Сони = С["soni"];
			Если Сони = Неопределено ИЛИ Сони <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Ост = СерверныеМеханизмы2.ОстаткаУчетКорДона(Док.Дата, Товар, Откуда, Серия, Док.Организация);
			Если Сони > Ост.Сони Тогда
				Ошибки.Добавить(Строка(Товар) + ": qoldiq " + Ост.Сони + ", ko'chirilmoqda " + Сони);
				Продолжить;
			КонецЕсли;
			Упк = СерверныеМеханизмы2.ПолучитьУпкСони(Товар);
			Стр = Док.Товарлар.Добавить();
			Стр.Товар = Товар;
			Стр.Серия = Серия;
			Стр.Сони = Сони;
			Стр.КорОстатка = Ост.Кор;
			Стр.ДонаОстатка = Ост.Дона;
			Стр.СониОстатка = Ост.Сони;
			Если Ост.УчетКорДона И Упк <> 0 Тогда
				Стр.Кор = Цел(Сони / Упк);
				Стр.Дона = Сони - Стр.Кор * Упк;
			КонецЕсли;
			Попытка
				Стр.Нархи = Ост.ОстаткаНархи;
			Исключение
			КонецПопытки;
			Стр.Сумма = Стр.Сони * Стр.Нархи;
			Всего = Всего + Сони;
		КонецЦикла;
		Если Ошибки.Количество() > 0 Тогда
			Возврат РезКочирить(Новый Структура("ok,error", Ложь, "Qoldiq yetarli emas. " + СтрСоединить(Ошибки, "; ")), 409);
		КонецЕсли;
		Если Док.Товарлар.Количество() = 0 Тогда
			Возврат РезКочирить(Новый Структура("ok,error", Ложь, "Ko'chiriladigan tovar yo'q."), 409);
		КонецЕсли;
		Док.КоличествоДокумента = Всего;

		Попытка
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			// O'tkazishda 1C xabarlarini (masalan, "qoldiq yetarli emas") ham javobga qo'shamiz
			Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Для Каждого Сооб Из ПолучитьСообщенияПользователю(Истина) Цикл
				Текст = Текст + " | " + Сооб.Текст;
			КонецЦикла;
			Возврат РезКочирить(Новый Структура("ok,error", Ложь, "Hujjat o'tkazilmadi: " + Текст), 409);
		КонецПопытки;

		Если ЗначениеЗаполнено(UID) Тогда
			УстановитьПривилегированныйРежим(Истина);
			ХранилищеОбщихНастроек.Сохранить("MobilOstatka.Otkazma", UID, XMLСтрока(Док.Ссылка), , "MobilOstatka");
		КонецЕсли;

		Ответ = Новый Структура;
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("nomer", СокрЛП(Док.Номер));
		Ответ.Вставить("tranzit", НЕ Док.ТоварКабулКилинди И ЗначениеЗаполнено(Куда.ТранзитныйСклад));
		Возврат РезКочирить(Ответ);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Текст = "";
		Пока Инфо <> Неопределено Цикл
			Текст = Текст + Инфо.Описание + " | ";
			Инфо = Инфо.Причина;
		КонецЦикла;
		Возврат РезКочирить(Новый Структура("ok,error", Ложь, Текст), 500);
	КонецПопытки;
КонецФункции

// ===================== QOLDIQLAR (ko'rish) =====================

// /qoldiq/{q}?sklad=<id>  — tovar nomi (yoki aniq artikul) bo'yicha qoldiq.
// sklad bo'lmasa: BARCHA filiallar bo'yicha jami va har bir tovar uchun filiallar ro'yxati ("filiallar").
// sklad bo'lsa: faqat shu ombordagi qoldiq.
Функция QoldiqGet(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок = Неопределено Тогда
		Блок = ПроверкаБулима(Запрос, "qoldiq");
	КонецЕсли;
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Поиск = Запрос.ПараметрыURL.Получить("q");
	СкладИд = Запрос.ПараметрыЗапроса.Получить("sklad");
	ПоСкладу = ЗначениеЗаполнено(СкладИд);
	ФилиалИд = Запрос.ПараметрыЗапроса.Получить("filial");
	ПоФилиалу = НЕ ПоСкладу И ЗначениеЗаполнено(ФилиалИд);
	МойФилиал = ФилиалПользователя();

	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	О.Товар КАК Товар,
	|	О.Товар.Наименование КАК Имя,
	|	О.Товар.Улчови.Наименование КАК Ед,
	|	О.Серия КАК Серия,
	|	СУММА(О.СониОстаток) КАК Сони,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ О.Склад) КАК Складов
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки({СКЛАД}) КАК О
	|ГДЕ
	|	О.СониОстаток > 0
	|	И НЕ О.Склад.НеАктив
	|	И (НЕ &ПоФилиалу ИЛИ О.Склад.Филиал = &Филиал)
	|	И (ИСТИНА {ПОИСК} ИЛИ О.Товар.Артикул = &Артикул)
	|СГРУППИРОВАТЬ ПО
	|	О.Товар, О.Товар.Наименование, О.Товар.Улчови.Наименование, О.Серия
	|УПОРЯДОЧИТЬ ПО
	|	Имя";
	З.Текст = СтрЗаменить(З.Текст, "{СКЛАД}", ?(ПоСкладу, ", Склад = &Склад", ""));
	З.Текст = СтрЗаменить(З.Текст, "{ПОИСК}", УсловиеПоиска(З, "О.Товар.Наименование", Поиск));
	Если ПоСкладу Тогда
		З.УстановитьПараметр("Склад", СкладПоИд(СкладИд));
	КонецЕсли;
	З.УстановитьПараметр("Артикул", СокрЛП(?(Поиск = Неопределено, "", Поиск)));
	З.УстановитьПараметр("ПоФилиалу", ПоФилиалу);
	З.УстановитьПараметр("Филиал", ?(ПоФилиалу, ФилиалПоИд(ФилиалИд), Неопределено));

	Рез = Новый Массив;
	ПоКлючу = Новый Соответствие;
	Товары = Новый Массив;
	Выб = З.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Э = Новый Структура;
		Э.Вставить("id", XMLСтрока(Выб.Товар));
		Э.Вставить("name", Выб.Имя);
		Э.Вставить("seria", ?(ЗначениеЗаполнено(Выб.Серия), XMLСтрока(Выб.Серия), ""));
		Э.Вставить("seria_name", ?(ЗначениеЗаполнено(Выб.Серия), Строка(Выб.Серия), ""));
		Э.Вставить("soni", Выб.Сони);
		Э.Вставить("birlik", ?(Выб.Ед = Null, "", Выб.Ед));
		Э.Вставить("omborlar", Выб.Складов);
		Э.Вставить("filiallar", Новый Массив);
		Рез.Добавить(Э);
		ПоКлючу.Вставить(Э.id + "|" + Э.seria, Э);
		Если Товары.Найти(Выб.Товар) = Неопределено Тогда
			Товары.Добавить(Выб.Товар);
		КонецЕсли;
	КонецЦикла;

	// Har bir tovar qaysi filiallarda qanchadan borligi (eng ko'pi birinchi)
	Если НЕ ПоСкладу И НЕ ПоФилиалу И Товары.Количество() > 0 Тогда
		Ф = Новый Запрос;
		Ф.Текст =
		"ВЫБРАТЬ
		|	О.Товар КАК Товар,
		|	О.Серия КАК Серия,
		|	О.Склад.Филиал КАК Филиал,
		|	СУММА(О.СониОстаток) КАК Сони
		|ИЗ
		|	РегистрНакопления.Остатки.Остатки(, Товар В (&Товары)) КАК О
		|ГДЕ
		|	О.СониОстаток > 0
		|	И НЕ О.Склад.НеАктив
		|СГРУППИРОВАТЬ ПО
		|	О.Товар, О.Серия, О.Склад.Филиал
		|УПОРЯДОЧИТЬ ПО
		|	Сони УБЫВ";
		Ф.УстановитьПараметр("Товары", Товары);
		ВыбФ = Ф.Выполнить().Выбрать();
		Пока ВыбФ.Следующий() Цикл
			Э = ПоКлючу.Получить(XMLСтрока(ВыбФ.Товар) + "|" + ?(ЗначениеЗаполнено(ВыбФ.Серия), XMLСтрока(ВыбФ.Серия), ""));
			Если Э = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Э.filiallar.Добавить(Новый Структура("name,soni,meniki",
				?(ЗначениеЗаполнено(ВыбФ.Филиал), Строка(ВыбФ.Филиал), "Filialsiz"), ВыбФ.Сони,
				ЗначениеЗаполнено(МойФилиал) И ВыбФ.Филиал = МойФилиал));
		КонецЦикла;
	КонецЕсли;
	Возврат JsonОтвет(Рез);
КонецФункции

// /qoldiqlar/{id}?seria=<id> — bitta tovarning BARCHA filiallardagi omborlar bo'yicha qoldig'i
// (filial nomi bilan; avval o'z filiali, keyin qolganlari, har birida eng ko'pi birinchi)
Функция QoldiqlarGet(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок = Неопределено Тогда
		Блок = ПроверкаБулима(Запрос, "qoldiq");
	КонецЕсли;
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Товар = Справочники.Товарлар.ПолучитьСсылку(Новый УникальныйИдентификатор(Запрос.ПараметрыURL.Получить("id")));
	СерияИд = Запрос.ПараметрыЗапроса.Получить("seria");
	Серия = ?(ЗначениеЗаполнено(СерияИд),
		Справочники.ТоварСериялари.ПолучитьСсылку(Новый УникальныйИдентификатор(СерияИд)),
		Справочники.ТоварСериялари.ПустаяСсылка());
	МойФилиал = ФилиалПользователя();
	ФилиалИд = Запрос.ПараметрыЗапроса.Получить("filial");
	ПоФилиалу = ЗначениеЗаполнено(ФилиалИд);

	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ
	|	О.Склад КАК Склад,
	|	О.Склад.Наименование КАК Имя,
	|	О.Склад.Филиал КАК Филиал,
	|	ВЫБОР КОГДА &ЕстьФилиал И О.Склад.Филиал = &МойФилиал ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК Порядок,
	|	СУММА(О.СониОстаток) КАК Сони
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки(, Товар = &Товар И Серия = &Серия) КАК О
	|ГДЕ
	|	О.СониОстаток > 0
	|	И НЕ О.Склад.НеАктив
	|	И (НЕ &ПоФилиалу ИЛИ О.Склад.Филиал = &Филиал)
	|СГРУППИРОВАТЬ ПО
	|	О.Склад, О.Склад.Наименование, О.Склад.Филиал
	|УПОРЯДОЧИТЬ ПО
	|	Порядок, О.Склад.Филиал.Наименование, Сони УБЫВ";
	З.УстановитьПараметр("Товар", Товар);
	З.УстановитьПараметр("Серия", Серия);
	З.УстановитьПараметр("ЕстьФилиал", ЗначениеЗаполнено(МойФилиал));
	З.УстановитьПараметр("МойФилиал", МойФилиал);
	З.УстановитьПараметр("ПоФилиалу", ПоФилиалу);
	З.УстановитьПараметр("Филиал", ?(ПоФилиалу, ФилиалПоИд(ФилиалИд), Неопределено));
	Рез = Новый Массив;
	Выб = З.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Рез.Добавить(Новый Структура("id,name,soni,filial,meniki", XMLСтрока(Выб.Склад), Выб.Имя, Выб.Сони,
			?(ЗначениеЗаполнено(Выб.Филиал), Строка(Выб.Филиал), "Filialsiz"), Выб.Порядок = 0));
	КонецЦикла;
	Возврат JsonОтвет(Рез);
КонецФункции

// ===================== XODIMLAR (ilovaning o'z foydalanuvchilari) =====================
// Ro'yxat platformaning umumiy sozlamalar xotirasida saqlanadi (ХранилищеОбщихНастроек):
// asosiy konfiguratsiyaga ham, kengaytma tuzilishiga ham jadval qo'shilmaydi.
// Har bir xodim: Имя · ПИН (sha256 xesh) · Логин1С / Пароль1С (qaysi 1C login orqali ishlaydi) · Активен ·
//                Ошибок (5 ta noto'g'ri PIN — blok) · ПоследнийВход · Токен (joriy sessiya)
// Ro'yxatda faol xodim bo'lmasa, ilova avvalgidek 1C foydalanuvchilari bilan ishlaydi.

Функция ХодимларПрочитать()
	УстановитьПривилегированныйРежим(Истина);
	Список = ХранилищеОбщихНастроек.Загрузить("MobilOstatka.Xodimlar", "list", , "MobilOstatka");
	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Список = Новый Массив;
	КонецЕсли;
	Возврат Список;
КонецФункции

Процедура ХодимларЗаписать(Список)
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("MobilOstatka.Xodimlar", "list", Список, "Mobil ilova xodimlari", "MobilOstatka");
КонецПроцедуры

Функция НайтиХодима(Список, Имя)
	Для Каждого Х Из Список Цикл
		Если НРег(СокрЛП(Х.Имя)) = НРег(СокрЛП(Имя)) Тогда
			Возврат Х;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ХодимларВключены()
	Для Каждого Х Из ХодимларПрочитать() Цикл
		Если Х.Активен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЗаголовокЗапроса(Запрос, Имя)
	Для Каждого З Из Запрос.Заголовки Цикл
		Если НРег(З.Ключ) = Имя Тогда
			Возврат СокрЛП(З.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Sessiya tokeni (X-Xodim-Token) bo'yicha faol xodim; topilmasa Неопределено
Функция ХодимПоТокену(Запрос)
	Токен = ЗаголовокЗапроса(Запрос, "x-xodim-token");
	Если ПустаяСтрока(Токен) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Х Из ХодимларПрочитать() Цикл
		Если Х.Активен И Х.Токен = Токен Тогда
			Возврат Х;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ИмяХодима(Запрос)
	Х = ХодимПоТокену(Запрос);
	Возврат ?(Х = Неопределено, "", Х.Имя);
КонецФункции

Функция ТекстХодима(Имя)
	Возврат ?(ЗначениеЗаполнено(Имя), " — " + Имя, "");
КонецФункции

// Xodimlar yoqilgan bo'lsa, har bir so'rovda haqiqiy sessiya tokeni bo'lishi shart — ilova versiyasidan qat'i nazar
// (2.1 gacha 1.11 dan eski versiyalar uchun istisna bor edi: 1C login/parolini bilgan odam tokensiz kira olardi).
Функция ПроверкаХодима(Запрос, Версия)
	Если НЕ ХодимларВключены() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Х = ХодимПоТокену(Запрос);
	Если Х <> Неопределено И НРег(СокрЛП(Х.Логин1С)) = НРег(ИмяПользователя()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат JsonОтвет(Новый Структура("ok,relogin,error", Ложь, Истина, "Sessiya tugagan. Qayta kiring."), 200);
КонецФункции

Функция ПроверкаДоступа(Запрос, Версия, БезЛокации)
	Если БезЛокации Тогда
		Возврат Неопределено;
	КонецЕсли;
	Блок = ПроверкаХодима(Запрос, Версия);
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	// Administrator xodimga "joylashuv shart emas" belgisini qo'ygan bo'lsa, GPS tekshirilmaydi
	Х = ХодимПоТокену(Запрос);
	Если Х <> Неопределено И НЕ ХодимGPS(Х) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПроверкаЛокации(Запрос, Версия);
КонецФункции

// Xodimdan do'kon hududida bo'lish talab qilinadimi (yangi maydon: eski yozuvlarda yo'q — talab qilinadi)
Функция ХодимGPS(Х)
	Если Х.Свойство("GPS") Тогда
		Возврат Х.GPS;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Strukturada maydon bo'lmasa (eski yozuv) — ПоУмолчанию
Функция ПолеХодима(Х, Имя, ПоУмолчанию = "")
	Знч = Неопределено;
	Если Х.Свойство(Имя, Знч) И Знч <> Неопределено Тогда
		Возврат Знч;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

// ---- Telefonni biriktirish ----
// Xodim birinchi kirgan telefon (X-Qurilma-Id = ANDROID_ID) unga biriktiriladi: БогИд/БогНом/БогСана.
// Boshqa telefondan kirsa — kirish rad etiladi va telefon "kutilmoqda" bo'ladi (КутИд/КутНом/КутСана/КутSIM),
// administrator «Xodimlar»da ruxsat beradi. Богла = Ложь bo'lsa (masalan administrator) — istalgan telefondan.
Функция ХодимБогла(Х)
	Возврат ПолеХодима(Х, "Богла", Истина) = Истина;
КонецФункции

// ---- Bo'limlar: xodimga ochiq bo'limlar (kunlik, ichki, otkazma, qoldiq), vergul bilan ----
// Maydon yo'q (eski yozuv) — hammasi ochiq.
Функция БулимларХодима(Х)
	Если Х <> Неопределено И Х.Свойство("Булимлар") И ТипЗнч(Х.Булимлар) = Тип("Строка") Тогда
		Возврат Х.Булимлар;
	КонецЕсли;
	Возврат "kunlik,ichki,otkazma,qoldiq";
КонецФункции

Функция БулимНомлари(Коды)
	Ном = Новый Соответствие;
	Ном.Вставить("kunlik", "Kunlik sanoq");
	Ном.Вставить("ichki", "Ichki sanoq");
	Ном.Вставить("otkazma", "O'tkazma");
	Ном.Вставить("qoldiq", "Qoldiqlar");
	Рез = Новый Массив;
	Для Каждого К Из СтрРазделить(Коды, ",", Ложь) Цикл
		Рез.Добавить(?(Ном[К] = Неопределено, К, Ном[К]));
	КонецЦикла;
	Возврат СтрСоединить(Рез, ", ");
КонецФункции

Функция БулимларМассив(Х)
	Возврат СтрРазделить(БулимларХодима(Х), ",", Ложь);
КонецФункции

// Коды — vergul bilan: kamida bittasi xodimga ochiq bo'lsa ruxsat. Xodim rejimi o'chiq bo'lsa — hammasi ochiq.
Функция ПроверкаБулима(Запрос, Коды)
	Х = ХодимПоТокену(Запрос);
	Если Х = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Бор = "," + БулимларХодима(Х) + ",";
	Для Каждого К Из СтрРазделить(Коды, ",", Ложь) Цикл
		Если СтрНайти(Бор, "," + К + ",") > 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат JsonОтвет(Новый Структура("ok,ruxsat,error", Ложь, Ложь, "Bu bo'lim sizga yopilgan. Administratorga murojaat qiling."), 403);
КонецФункции

// ===================== TARIX (amallar va kirishlar) =====================
// ХранилищеОбщихНастроек("MobilOstatka.Tarix", "<A|K>|yyyyMMdd|<xodim>", массив, , "MobilOstatka"):
// har kun va har xodim uchun alohida yozuv (bir vaqtda ikki xodim yozganda bir-birini o'chirmaydi).
// A — amallar, K — kirishlar. 180 kundan eskilari administrator tarixni ochganda o'chiriladi.
Процедура ЗаписатьТарих(Тур, Имя, Запись)
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Сейчас = ТекущаяДата();
		Кто = СокрЛП(?(ПустаяСтрока(Имя), ИмяПользователя(), Имя));
		Ключ = Тур + "|" + Формат(Сейчас, "ДФ=yyyyMMdd") + "|" + Лев(СтрЗаменить(Кто, "|", "/"), 90);
		Массив = ХранилищеОбщихНастроек.Загрузить("MobilOstatka.Tarix", Ключ, , "MobilOstatka");
		Если ТипЗнч(Массив) <> Тип("Массив") Тогда
			Массив = Новый Массив;
		КонецЕсли;
		Запись.Вставить("v", Формат(Сейчас, "ДФ=HH:mm:ss"));
		Массив.Добавить(Запись);
		ХранилищеОбщихНастроек.Сохранить("MobilOstatka.Tarix", Ключ, Массив, , "MobilOstatka");
	Исключение
		// tarix yozilmasa ham asosiy amal to'xtamasin
	КонецПопытки;
КонецПроцедуры

// Тур: kunlik / ichki / otkazma / xodim
Процедура ТарихАмал(Запрос, Тур, Текст, Номер = "")
	ЗаписатьТарих("A", ИмяХодима(Запрос), Новый Структура("t,m,h,l", Тур, Текст, Номер, ИмяПользователя()));
КонецПроцедуры

Функция ЗаголовокURL(Запрос, Имя)
	З = ЗаголовокЗапроса(Запрос, Имя);
	Попытка
		Возврат РаскодироватьСтроку(З, СпособКодированияСтроки.КодировкаURL);
	Исключение
		Возврат З;
	КонецПопытки;
КонецФункции

Процедура ТарихКириш(Запрос, Имя, Ок, Текст)
	ЗаписатьТарих("K", Имя, Новый Структура("ok,m,q,id,ver,s", Ок, Текст,
		Лев(ЗаголовокURL(Запрос, "x-qurilma"), 120), Лев(ЗаголовокЗапроса(Запрос, "x-qurilma-id"), 64), ЗаголовокЗапроса(Запрос, "x-app-version"),
		Лев(ЗаголовокЗапроса(Запрос, "x-sim"), 60)));
КонецПроцедуры

Функция Чис(Н)
	Возврат Формат(Н, "ЧГ=0; ЧН=0");
КонецФункции

// /xodimlar?tarix=amal|kirish&kun=1..90&xodim=<ism>  -> [{sana, vaqt, xodim, ...}] (yangilari birinchi, ko'pi 1000 ta)
Функция ТарихСписок(Запрос)
	Тур = ?(Запрос.ПараметрыЗапроса.Получить("tarix") = "kirish", "K", "A");
	Кун = 7;
	Попытка
		Кун = Макс(1, Мин(90, Число(Запрос.ПараметрыЗапроса.Получить("kun"))));
	Исключение
	КонецПопытки;
	Фильтр = Запрос.ПараметрыЗапроса.Получить("xodim");
	Фильтр = ?(Фильтр = Неопределено, "", НРег(СокрЛП(Фильтр)));
	Сегодня = НачалоДня(ТекущаяДата());
	Дан = Формат(Сегодня - (Кун - 1) * 86400, "ДФ=yyyyMMdd");
	Чистка = Формат(Сегодня - 180 * 86400, "ДФ=yyyyMMdd");

	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("k");
	ТЗ.Колонки.Добавить("d");
	Ключи = ХранилищеОбщихНастроек.ПолучитьСписок("MobilOstatka.Tarix", "MobilOstatka");
	Для Каждого Э Из Ключи Цикл
		Ключ = Строка(Э.Значение);
		Ч = СтрРазделить(Ключ, "|", Истина);
		Если Ч.Количество() < 3 Тогда
			Продолжить;
		КонецЕсли;
		Если Ч[1] < Чистка Тогда
			ХранилищеОбщихНастроек.Удалить("MobilOstatka.Tarix", Ключ, "MobilOstatka");
			Продолжить;
		КонецЕсли;
		Если Ч[0] <> Тур ИЛИ Ч[1] < Дан Тогда
			Продолжить;
		КонецЕсли;
		Имя = Ч[2];
		Если Фильтр <> "" И НРег(Имя) <> Фильтр Тогда
			Продолжить;
		КонецЕсли;
		Массив = ХранилищеОбщихНастроек.Загрузить("MobilOstatka.Tarix", Ключ, , "MobilOstatka");
		Если ТипЗнч(Массив) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Сана = Сред(Ч[1], 7, 2) + "." + Сред(Ч[1], 5, 2) + "." + Лев(Ч[1], 4);
		Н = 0;
		Для Каждого З Из Массив Цикл
			Н = Н + 1;
			Э2 = Новый Структура("sana,vaqt,xodim", Сана, З.v, Имя);
			Для Каждого П Из З Цикл
				Если П.Ключ <> "v" Тогда
					Э2.Вставить(П.Ключ, П.Значение);
				КонецЕсли;
			КонецЦикла;
			Стр = ТЗ.Добавить();
			Стр.k = Ч[1] + З.v + Формат(Н, "ЧЦ=6; ЧВН=; ЧГ=0"); // bir soniyadagi yozuvlar — yozilish tartibida
			Стр.d = Э2;
		КонецЦикла;
	КонецЦикла;
	ТЗ.Сортировать("k Убыв");
	Рез = Новый Массив;
	Для Каждого Стр Из ТЗ Цикл
		Рез.Добавить(Стр.d);
		Если Рез.Количество() >= 1000 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// /kirish  POST {"name":"...", "pin":"..."} -> {ok, name, login, password, token}
// So'rov ilovaning umumiy (ro'yxat uchun) logini bilan keladi; javobdagi 1C login bilan ilova keyin ishlaydi.
Функция KirishPost(Запрос)
	Блок = ПроверкаВерсии(Запрос, Истина);
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Попытка
		Чт = Новый ЧтениеJSON;
		Чт.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
		Данные = ПрочитатьJSON(Чт, Истина);
		Имя = СокрЛП(Строка(Данные["name"]));
		ПИН = СокрЛП(Строка(Данные["pin"]));
	Исключение
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "So'rov noto'g'ri."), 400);
	КонецПопытки;

	Список = ХодимларПрочитать();
	Х = НайтиХодима(Список, Имя);
	Если Х = Неопределено ИЛИ НЕ Х.Активен Тогда
		ТарихКириш(Запрос, Имя, Ложь, ?(Х = Неопределено, "Xodim topilmadi", "O'chirilgan xodim kirishga urindi"));
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "Xodim topilmadi yoki o'chirilgan."), 409);
	КонецЕсли;
	Если Х.Ошибок >= 5 Тогда
		ТарихКириш(Запрос, Х.Имя, Ложь, "Bloklangan xodim kirishga urindi");
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "PIN 5 marta noto'g'ri kiritildi, xodim bloklandi. Administratorga murojaat qiling."), 409);
	КонецЕсли;
	Если ПустаяСтрока(Х.ПИН) Тогда
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "Bu xodimga PIN-kod o'rnatilmagan. Administratorga murojaat qiling."), 409);
	КонецЕсли;
	Если Х.ПИН <> Расш1_МобилХодимлар.ХешПИН(Х.Имя, ПИН) Тогда
		Х.Ошибок = Х.Ошибок + 1;
		ХодимларЗаписать(Список);
		Осталось = 5 - Х.Ошибок;
		ТарихКириш(Запрос, Х.Имя, Ложь, "PIN noto'g'ri (" + Чис(Х.Ошибок) + "-urinish)" + ?(Осталось > 0, "", " — bloklandi"));
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "PIN noto'g'ri." + ?(Осталось > 0, " Yana " + Осталось + " ta urinish qoldi.", " Xodim bloklandi.")), 409);
	КонецЕсли;
	Если ПустаяСтрока(Х.Логин1С) Тогда
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "Xodimga 1C login biriktirilmagan. Administratorga murojaat qiling."), 409);
	КонецЕсли;
	Курилма = Лев(ЗаголовокURL(Запрос, "x-qurilma"), 120);
	КурилмаИд = Лев(ЗаголовокЗапроса(Запрос, "x-qurilma-id"), 64);
	SIM = Лев(ЗаголовокЗапроса(Запрос, "x-sim"), 60);
	Изох = "Kirdi";
	Если ХодимБогла(Х) Тогда
		Если ПустаяСтрока(КурилмаИд) Тогда
			ТарихКириш(Запрос, Х.Имя, Ложь, "Telefon aniqlanmadi (eski ilova)");
			Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "Ilovani yangilang: yangi versiyada telefon tekshiriladi."), 409);
		КонецЕсли;
		БогИд = ПолеХодима(Х, "БогИд");
		Если ПустаяСтрока(БогИд) Тогда
			Х.Вставить("БогИд", КурилмаИд);
			Х.Вставить("БогНом", Курилма);
			Х.Вставить("БогСана", ТекущаяДата());
			Изох = "Kirdi — telefon xodimga biriktirildi";
		ИначеЕсли БогИд <> КурилмаИд Тогда
			Х.Вставить("КутИд", КурилмаИд);
			Х.Вставить("КутНом", Курилма);
			Х.Вставить("КутСана", ТекущаяДата());
			Х.Вставить("КутSIM", SIM);
			ХодимларЗаписать(Список);
			ТарихКириш(Запрос, Х.Имя, Ложь, "Boshqa telefondan urinish — ruxsat kutilmoqda");
			Возврат JsonОтвет(Новый Структура("ok,error", Ложь,
				"Bu telefon sizga biriktirilmagan. Administrator «Xodimlar» bo'limida ruxsat bersa, kira olasiz."), 409);
		КонецЕсли;
	КонецЕсли;
	Х.Ошибок = 0;
	Х.Токен = Строка(Новый УникальныйИдентификатор);
	Х.ПоследнийВход = ТекущаяДата();
	Янги = (Изох = "Kirdi") И ЗначениеЗаполнено(ПолеХодима(Х, "КурилмаИд")) И ЗначениеЗаполнено(КурилмаИд)
		И ПолеХодима(Х, "КурилмаИд") <> КурилмаИд;
	Х.Вставить("Курилма", Курилма);
	Х.Вставить("КурилмаИд", КурилмаИд);
	Если ЗначениеЗаполнено(SIM) Тогда
		Х.Вставить("SIM", SIM);
	КонецЕсли;
	ХодимларЗаписать(Список);
	ТарихКириш(Запрос, Х.Имя, Истина, ?(Янги, "Kirdi — YANGI QURILMA", Изох));
	ГеоСаклаш(Х.Имя, Дата(1, 1, 1));
	Возврат JsonОтвет(Новый Структура("ok,name,login,password,token,bolimlar", Истина, Х.Имя, Х.Логин1С, Х.Пароль1С, Х.Токен, БулимларМассив(Х)));
КонецФункции

// ---- Ro'yxatni boshqarish: faqat 1C administratori (ПолныеПрава / Администратор rolli login) ----
Функция ЭтоАдминистратор()
	Возврат РольДоступна("ПолныеПрава") ИЛИ РольДоступна("Администратор");
КонецФункции

// /xodimlar           GET -> [{name, login1c, faol, xato, oxirgi, pin, gps}]   (pin: o'rnatilganmi — true/false; xesh qaytarilmaydi)
// /xodimlar?users=1   GET -> [{login, name}] — 1C foydalanuvchilari (xodimga login tanlash uchun)
Функция XodimlarGet(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Если НЕ ЭтоАдминистратор() Тогда
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "Bu bo'lim faqat administrator uchun."), 403);
	КонецЕсли;
	Если Запрос.ПараметрыЗапроса.Получить("tarix") <> Неопределено Тогда
		Возврат JsonОтвет(ТарихСписок(Запрос));
	КонецЕсли;
	Рез = Новый Массив;
	Если Запрос.ПараметрыЗапроса.Получить("users") = "1" Тогда
		УстановитьПривилегированныйРежим(Истина);
		ТЗ = Новый ТаблицаЗначений;
		ТЗ.Колонки.Добавить("login");
		ТЗ.Колонки.Добавить("name");
		Для Каждого П Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
			Если НЕ П.АутентификацияСтандартная Тогда
				Продолжить;
			КонецЕсли;
			Стр = ТЗ.Добавить();
			Стр.login = П.Имя;
			Стр.name = ?(ПустаяСтрока(П.ПолноеИмя), П.Имя, П.ПолноеИмя);
		КонецЦикла;
		ТЗ.Сортировать("name");
		Для Каждого Стр Из ТЗ Цикл
			Рез.Добавить(Новый Структура("login,name", Стр.login, Стр.name));
		КонецЦикла;
		Возврат JsonОтвет(Рез);
	КонецЕсли;
	Для Каждого Х Из ХодимларПрочитать() Цикл
		Э = Новый Структура("name,login1c,faol,xato,oxirgi,pin,gps", Х.Имя, Х.Логин1С, Х.Активен, Х.Ошибок,
			?(ЗначениеЗаполнено(Х.ПоследнийВход), Формат(Х.ПоследнийВход, "ДФ='dd.MM.yyyy HH:mm'"), ""), НЕ ПустаяСтрока(Х.ПИН), ХодимGPS(Х));
		Э.Вставить("bolimlar", БулимларМассив(Х));
		Э.Вставить("qurilma", ?(Х.Свойство("Курилма"), Х.Курилма, ""));
		Э.Вставить("telefon", ПолеХодима(Х, "Телефон"));
		Э.Вставить("sim", ПолеХодима(Х, "SIM"));
		Э.Вставить("boglash", ХодимБогла(Х));
		Э.Вставить("bog", ПолеХодима(Х, "БогНом"));
		Э.Вставить("bogSana", ?(ЗначениеЗаполнено(ПолеХодима(Х, "БогСана", Дата(1, 1, 1))), Формат(Х.БогСана, "ДФ='dd.MM.yyyy HH:mm'"), ""));
		Э.Вставить("bogBor", ЗначениеЗаполнено(ПолеХодима(Х, "БогИд")));
		Э.Вставить("kut", ПолеХодима(Х, "КутНом"));
		Э.Вставить("kutBor", ЗначениеЗаполнено(ПолеХодима(Х, "КутИд")));
		Э.Вставить("kutSana", ?(ЗначениеЗаполнено(ПолеХодима(Х, "КутСана", Дата(1, 1, 1))), Формат(Х.КутСана, "ДФ='dd.MM.yyyy HH:mm'"), ""));
		Э.Вставить("kutSim", ПолеХодима(Х, "КутSIM"));
		Рез.Добавить(Э);
	КонецЦикла;
	Возврат JsonОтвет(Рез);
КонецФункции

// /xodimlar  POST {"name", "pin"?, "login1c"?, "parol1c"?, "faol"?, "gps"?, "blokdan"?: true, "ochir"?: true}
// Bo'lmasa qo'shadi, bor bo'lsa yangilaydi (bo'sh qoldirilgan maydon o'zgarmaydi). PIN yangilansa — blok va sessiya tozalanadi.
Функция XodimlarPost(Запрос)
	Блок = ПроверкаВерсии(Запрос);
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	Если НЕ ЭтоАдминистратор() Тогда
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "Bu bo'lim faqat administrator uchun."), 403);
	КонецЕсли;
	Попытка
		Чт = Новый ЧтениеJSON;
		Чт.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
		Д = ПрочитатьJSON(Чт, Истина);
	Исключение
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "So'rov noto'g'ri."), 400);
	КонецПопытки;
	Имя = СокрЛП(Строка(Д["name"]));
	Если ПустаяСтрока(Имя) Тогда
		Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "Xodim ismini yozing."), 409);
	КонецЕсли;
	Список = ХодимларПрочитать();
	Х = НайтиХодима(Список, Имя);
	Если Д["ochir"] = Истина Тогда
		Если Х <> Неопределено Тогда
			Список.Удалить(Список.Найти(Х));
			ХодимларЗаписать(Список);
			ТарихАмал(Запрос, "xodim", "Xodim o'chirildi: " + Имя);
		КонецЕсли;
		Возврат JsonОтвет(Новый Структура("ok", Истина));
	КонецЕсли;
	Узгариш = Новый Массив;
	Янги = (Х = Неопределено);
	Если Х = Неопределено Тогда
		Х = Новый Структура("Имя,ПИН,Логин1С,Пароль1С,Активен,Ошибок,ПоследнийВход,Токен,GPS", Имя, "", "", "", Истина, 0, Дата(1, 1, 1), "", Истина);
		Список.Добавить(Х);
	КонецЕсли;
	Если ЗначениеЗаполнено(Д["pin"]) Тогда
		ПИН = СокрЛП(Строка(Д["pin"]));
		Если СтрДлина(ПИН) < 4 Тогда
			Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "PIN kamida 4 ta raqam bo'lsin."), 409);
		КонецЕсли;
		Х.ПИН = Расш1_МобилХодимлар.ХешПИН(Х.Имя, ПИН);
		Х.Ошибок = 0;
		Х.Токен = "";
		Узгариш.Добавить("PIN almashtirildi");
	КонецЕсли;
	Если Д["login1c"] <> Неопределено Тогда
		// Aynan 1C'dagidek saqlanadi: ba'zi loginlar bo'sh joy bilan boshlanadi (" Bekzodjon (Koppon)")
		Если Х.Логин1С <> Строка(Д["login1c"]) И НЕ Янги Тогда
			Узгариш.Добавить("1C login: " + СокрЛП(Д["login1c"]));
		КонецЕсли;
		Х.Логин1С = Строка(Д["login1c"]);
	КонецЕсли;
	Если ЗначениеЗаполнено(Д["parol1c"]) Тогда
		Х.Пароль1С = Строка(Д["parol1c"]);
		Если НЕ Янги Тогда
			Узгариш.Добавить("1C paroli yangilandi");
		КонецЕсли;
	КонецЕсли;
	Если Д["faol"] <> Неопределено Тогда
		Если Х.Активен <> (Д["faol"] = Истина) И НЕ Янги Тогда
			Узгариш.Добавить(?(Д["faol"] = Истина, "faollashtirildi", "O'CHIRILDI (faol emas)"));
		КонецЕсли;
		Х.Активен = (Д["faol"] = Истина);
		Если НЕ Х.Активен Тогда
			Х.Токен = "";
		КонецЕсли;
	КонецЕсли;
	Если Д["gps"] <> Неопределено Тогда
		Если ХодимGPS(Х) <> (Д["gps"] = Истина) И НЕ Янги Тогда
			Узгариш.Добавить(?(Д["gps"] = Истина, "GPS talab qilinadi", "GPS shart emas"));
		КонецЕсли;
		Х.Вставить("GPS", Д["gps"] = Истина);
	КонецЕсли;
	Если Д["bolimlar"] <> Неопределено Тогда
		Булим = Новый Массив;
		Для Каждого К Из Д["bolimlar"] Цикл
			К = НРег(СокрЛП(Строка(К)));
			Если СтрНайти(",kunlik,ichki,otkazma,qoldiq,", "," + К + ",") > 0 И Булим.Найти(К) = Неопределено Тогда
				Булим.Добавить(К);
			КонецЕсли;
		КонецЦикла;
		Если Булим.Количество() = 0 Тогда
			Возврат JsonОтвет(Новый Структура("ok,error", Ложь, "Kamida bitta bo'limni yoqing."), 409);
		КонецЕсли;
		Янгиси = СтрСоединить(Булим, ",");
		Если БулимларХодима(Х) <> Янгиси И НЕ Янги Тогда
			Узгариш.Добавить("bo'limlar: " + БулимНомлари(Янгиси));
		КонецЕсли;
		Х.Вставить("Булимлар", Янгиси);
	КонецЕсли;
	Если Д["blokdan"] = Истина Тогда
		Х.Ошибок = 0;
		Узгариш.Добавить("blokdan chiqarildi");
	КонецЕсли;
	Если Д["telefon"] <> Неопределено Тогда
		Тел = СокрЛП(Строка(Д["telefon"]));
		Если Тел <> ПолеХодима(Х, "Телефон") И НЕ Янги Тогда
			Узгариш.Добавить("telefon: " + ?(ПустаяСтрока(Тел), "o'chirildi", Тел));
		КонецЕсли;
		Х.Вставить("Телефон", Тел);
	КонецЕсли;
	Если Д["boglash"] <> Неопределено Тогда
		Если ХодимБогла(Х) <> (Д["boglash"] = Истина) И НЕ Янги Тогда
			Узгариш.Добавить(?(Д["boglash"] = Истина, "faqat biriktirilgan telefondan", "istalgan telefondan"));
		КонецЕсли;
		Х.Вставить("Богла", Д["boglash"] = Истина);
	КонецЕсли;
	Если Д["qurilma"] = "ruxsat" И ЗначениеЗаполнено(ПолеХодима(Х, "КутИд")) Тогда
		Узгариш.Добавить("yangi telefonga ruxsat berildi: " + ПолеХодима(Х, "КутНом"));
		Х.Вставить("БогИд", Х.КутИд);
		Х.Вставить("БогНом", ПолеХодима(Х, "КутНом"));
		Х.Вставить("БогСана", ТекущаяДата());
		Х.Вставить("КутИд", "");
		Х.Вставить("КутНом", "");
		Х.Вставить("КутSIM", "");
		Х.Вставить("КутСана", Дата(1, 1, 1));
	ИначеЕсли Д["qurilma"] = "rad" Тогда
		Узгариш.Добавить("yangi telefon rad etildi: " + ПолеХодима(Х, "КутНом"));
		Х.Вставить("КутИд", "");
		Х.Вставить("КутНом", "");
		Х.Вставить("КутSIM", "");
		Х.Вставить("КутСана", Дата(1, 1, 1));
	ИначеЕсли Д["qurilma"] = "tozalash" Тогда
		Узгариш.Добавить("telefon biriktirilishi bekor qilindi");
		Х.Вставить("БогИд", "");
		Х.Вставить("БогНом", "");
		Х.Вставить("БогСана", Дата(1, 1, 1));
		Х.Вставить("КутИд", "");
		Х.Вставить("КутНом", "");
		Х.Вставить("КутSIM", "");
		Х.Вставить("КутСана", Дата(1, 1, 1));
		Х.Токен = "";
	КонецЕсли;
	ХодимларЗаписать(Список);
	Если Янги Тогда
		ТарихАмал(Запрос, "xodim", "Xodim qo'shildi: " + Х.Имя + " (1C: " + СокрЛП(Х.Логин1С) + ")");
	ИначеЕсли Узгариш.Количество() > 0 Тогда
		ТарихАмал(Запрос, "xodim", "Xodim o'zgartirildi: " + Х.Имя + " — " + СтрСоединить(Узгариш, ", "));
	КонецЕсли;
	Возврат JsonОтвет(Новый Структура("ok", Истина));
КонецФункции

// ===================== FOYDALANUVCHILAR =====================
// Kirish oynasidagi ro'yxat: registrda faol xodimlar bo'lsa — ular ("xodim":true),
// bo'lmasa — 1C'da "Показывать в списке выбора" va "Аутентификация 1С:Предприятия" yoqilgan foydalanuvchilar.
Функция FoydalanuvchilarGet(Запрос)
	Блок = ПроверкаВерсии(Запрос, Истина); // ro'yxat uchun GPS kutilmaydi, kirishda (skladlar) tekshiriladi
	Если Блок <> Неопределено Тогда
		Возврат Блок;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);

	Рез = Новый Массив;
	Для Каждого Х Из ХодимларПрочитать() Цикл
		Если Х.Активен Тогда
			Рез.Добавить(Новый Структура("login,name,xodim", Х.Имя, Х.Имя, Истина));
		КонецЕсли;
	КонецЦикла;
	Если Рез.Количество() > 0 Тогда
		Возврат JsonОтвет(Рез);
	КонецЕсли;

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("login");
	ТЗ.Колонки.Добавить("name");
	Для Каждого П Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если НЕ П.АутентификацияСтандартная ИЛИ НЕ П.ПоказыватьВСпискеВыбора Тогда
			Продолжить;
		КонецЕсли;
		Стр = ТЗ.Добавить();
		Стр.login = П.Имя;
		Стр.name = ?(ПустаяСтрока(П.ПолноеИмя), П.Имя, П.ПолноеИмя);
	КонецЦикла;
	ТЗ.Сортировать("name");

	Рез = Новый Массив;
	Для Каждого Стр Из ТЗ Цикл
		Рез.Добавить(Новый Структура("login,name", Стр.login, Стр.name));
	КонецЦикла;
	Возврат JsonОтвет(Рез);
КонецФункции

// ===================== MAJBURIY YANGILASH =====================
// YANGI VERSIYA CHIQARGANDA FAQAT SHU FUNKSIYADAGI QIYMATLARNI O'ZGARTIRASIZ:
//   МинВерсия - shundan eski ilovalar ishlamaydi (index.html dagi APP_VER bilan solishtiriladi).
//               Avval yangi APK'ni serverga qo'ying, keyin shu raqamni oshiring.
//   Ссылка    - yangi APK yuklab olinadigan manzil
Функция НастройкиВерсии()
	Н = Новый Структура;
	Н.Вставить("МинВерсия", "1.6");
	Н.Вставить("Ссылка", "http://87.192.241.38:8090/ilova/domstroy.apk");
	Н.Вставить("Изох", "Ishlashni davom ettirish uchun ilovani yangilang.");
	// Versiya yubormaydigan eski ilovalar (1.1 dan oldingi APK'lar) ham bloklansinmi
	Н.Вставить("БезВерсииБлок", Истина);
	Возврат Н;
КонецФункции

Функция VersiyaGet(Запрос)
	Н = НастройкиВерсии();
	Ответ = Новый Структура("min,url,izoh", Н.МинВерсия, Н.Ссылка, Н.Изох);
	// Ilova sessiya tokeni bilan so'rasa — xodimga ochiq bo'limlar (bosh sahifadagi plitkalar uchun)
	Х = ХодимПоТокену(Запрос);
	Если Х <> Неопределено Тогда
		Ответ.Вставить("bolimlar", БулимларМассив(Х));
	КонецЕсли;
	Возврат JsonОтвет(Ответ);
КонецФункции

// Har bir HTTP-metod boshida chaqiriladi. Eski ilova bo'lsa {"update":true,...} javobini qaytaradi, aks holda Неопределено.
Функция ПроверкаВерсии(Запрос, БезЛокации = Ложь)
	Н = НастройкиВерсии();
	Версия = "";
	Для Каждого З Из Запрос.Заголовки Цикл
		Если НРег(З.Ключ) = "x-app-version" Тогда
			Версия = СокрЛП(З.Значение);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Версия) Тогда
		Если НЕ Н.БезВерсииБлок Тогда
			Возврат ПроверкаДоступа(Запрос, Версия, БезЛокации);
		КонецЕсли;
	ИначеЕсли СравнитьВерсии(Версия, Н.МинВерсия) >= 0 Тогда
		Возврат ПроверкаДоступа(Запрос, Версия, БезЛокации);
	КонецЕсли;
	Возврат ОтветОбновления(Н);
КонецФункции

Функция ОтветОбновления(Н)
	Ответ = Новый Структура;
	Ответ.Вставить("ok", Ложь);
	Ответ.Вставить("update", Истина);
	Ответ.Вставить("min", Н.МинВерсия);
	Ответ.Вставить("url", Н.Ссылка);
	Ответ.Вставить("izoh", Н.Изох);
	Ответ.Вставить("error", "Ilova eskirgan. Yangi versiyasini o'rnating.");
	// 426 kodini veb-server buzadi (400 "Некорректные символы в заголовке HTTP"),
	// shuning uchun 200 qaytariladi: ilova "update":true belgisiga qarab yangilash oynasini ochadi.
	Возврат JsonОтвет(Ответ, 200);
КонецФункции

// ===================== DO'KON HUDUDI (GPS) =====================
// Ilovadan faqat do'kon atrofida foydalanish mumkin. Qiymatlarni shu yerda o'zgartirasiz:
//   Включен     - Ложь qilsangiz tekshiruv o'chadi
//   Широта/Долгота, Радиус (metr)
//   МаксТочность - telefon joylashuvi bundan noaniqroq bo'lsa (metr), qabul qilinmaydi
//   Исключения  - tekshiruvsiz ishlaydigan 1C loginlari (vergul bilan), masalan "Admin,Muhammadrizo"
//   Интервал    - joylashuv necha daqiqada bir tekshiriladi (kirishda va keyin har Интервал daqiqada)
Функция НастройкиЛокации()
	Н = Новый Структура;
	Н.Вставить("Включен", Истина);
	Н.Вставить("Широта", 40.52705579036957);
	Н.Вставить("Долгота", 70.95357261816275);
	Н.Вставить("Радиус", 450);
	Н.Вставить("МаксТочность", 150);
	Н.Вставить("Исключения", "");
	Н.Вставить("Интервал", 20);
	// GPS'ni yuboradigan birinchi ilova versiyasi: undan eskilari yangilashga yuboriladi
	Н.Вставить("ВерсияGPS", "1.4");
	Возврат Н;
КонецФункции

// Ilova X-Geo sarlavhasida yuboradi: "lat,lon,aniqlik,mock" yoki "err:KOD".
// Ruxsat bo'lsa Неопределено, aks holda {"geo":true, "code", "error"} javobi.
Функция ПроверкаЛокации(Запрос, Версия)
	Л = НастройкиЛокации();
	Если НЕ Л.Включен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Логин = НРег(ИмяПользователя());
	Для Каждого Искл Из СтрРазделить(Л.Исключения, ",", Ложь) Цикл
		Если НРег(СокрЛП(Искл)) = Логин Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(Версия) ИЛИ СравнитьВерсии(Версия, Л.ВерсияGPS) < 0 Тогда
		Н = НастройкиВерсии();
		Н.МинВерсия = Л.ВерсияGPS;
		Возврат ОтветОбновления(Н);
	КонецЕсли;

	Гео = "";
	Для Каждого З Из Запрос.Заголовки Цикл
		Если НРег(З.Ключ) = "x-geo" Тогда
			Гео = СокрЛП(З.Значение);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Joylashuv har so'rovda emas: kirishdan keyin va oxirgi muvaffaqiyatli tekshiruvdan Интервал daqiqa o'tgach.
	// Ilova (2.3+) X-Geo ni faqat shu paytda yuboradi; yubormasa va muddat o'tgan bo'lsa — "need" (ilova GPS'ni olib qayta yuboradi).
	КлючГео = ?(ПустаяСтрока(ИмяХодима(Запрос)), "1c:" + ИмяПользователя(), ИмяХодима(Запрос));
	Если ПустаяСтрока(Гео) Тогда
		Если ГеоЯнги(КлючГео, Л.Интервал) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ОтветЛокации("need", "Joylashuv tekshirilmoqda...");
	КонецЕсли;
	Если СтрНачинаетсяС(Гео, "err:") Тогда
		Код = Сред(Гео, 5);
		Если Код = "DENIED" Тогда
			Текст = "Ilova ishlashi uchun joylashuvga ruxsat bering: Sozlamalar → Ruxsatlar → Joylashuv.";
		ИначеЕсли Код = "COARSE" Тогда
			Текст = "Joylashuv ruxsatida «Aniq joylashuv» ni yoqing.";
		ИначеЕсли Код = "OFF" Тогда
			Текст = "Telefonda GPS (joylashuv) o'chiq. Uni yoqing.";
		Иначе
			Текст = "Joylashuv aniqlanmadi. Ochiq joyga yoki deraza yoniga o'tib, qayta tekshiring.";
		КонецЕсли;
		Возврат ОтветЛокации(Код, Текст);
	КонецЕсли;

	Ч = СтрРазделить(Гео, ",", Ложь);
	Если Ч.Количество() < 4 Тогда
		Возврат ОтветЛокации("none", "Joylashuv noto'g'ri yuborildi. Ilovani qayta oching.");
	КонецЕсли;
	Попытка
		Шир = XMLЗначение(Тип("Число"), Ч[0]);
		Дол = XMLЗначение(Тип("Число"), Ч[1]);
		Точн = XMLЗначение(Тип("Число"), Ч[2]);
	Исключение
		Возврат ОтветЛокации("none", "Joylashuv noto'g'ri yuborildi. Ilovani qayta oching.");
	КонецПопытки;

	Если Ч[3] = "1" Тогда
		Возврат ОтветЛокации("mock", "Telefonda soxta joylashuv (Fake GPS) ilovasi yoqilgan. Uni o'chiring.");
	КонецЕсли;
	Если Точн > Л.МаксТочность Тогда
		Возврат ОтветЛокации("acc", "Joylashuv aniq emas (±" + Формат(Точн, "ЧГ=0") + " m). Ochiq joyga yoki deraza yoniga o'tib, qayta tekshiring.");
	КонецЕсли;

	Масофа = Расстояние(Шир, Дол, Л.Широта, Л.Долгота);
	Если Масофа > Л.Радиус Тогда
		ГеоСаклаш(КлючГео, Дата(1, 1, 1));
		Возврат ОтветЛокации("far", "Siz do'kondan " + ТекстМасофы(Масофа) + " uzoqdasiz. Ilovadan faqat do'kon hududida foydalanish mumkin.");
	КонецЕсли;
	ГеоСаклаш(КлючГео, ТекущаяДата());
	Возврат Неопределено;
КонецФункции

// Oxirgi muvaffaqiyatli joylashuv tekshiruvi vaqti: ХранилищеОбщихНастроек("MobilOstatka.Geo", <xodim yoki "1c:login">)
Функция ГеоЯнги(Ключ, Интервал)
	УстановитьПривилегированныйРежим(Истина);
	Вакт = ХранилищеОбщихНастроек.Загрузить("MobilOstatka.Geo", Лев(Ключ, 100), , "MobilOstatka");
	Возврат ТипЗнч(Вакт) = Тип("Дата") И ЗначениеЗаполнено(Вакт) И ТекущаяДата() - Вакт < Интервал * 60;
КонецФункции

Процедура ГеоСаклаш(Ключ, Вакт)
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ХранилищеОбщихНастроек.Сохранить("MobilOstatka.Geo", Лев(Ключ, 100), Вакт, , "MobilOstatka");
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция ОтветЛокации(Код, Текст)
	Возврат JsonОтвет(Новый Структура("ok,geo,code,error", Ложь, Истина, Код, Текст), 200);
КонецФункции

// Ikki nuqta orasidagi masofa (metr). Yuzlab metr uchun aniqligi yetarli.
Функция Расстояние(Шир1, Дол1, Шир2, Дол2)
	Рад = 3.14159265358979 / 180;
	X = (Дол2 - Дол1) * Рад * Cos((Шир1 + Шир2) / 2 * Рад);
	Y = (Шир2 - Шир1) * Рад;
	Возврат 6371000 * Sqrt(X * X + Y * Y);
КонецФункции

Функция ТекстМасофы(М)
	Если М >= 1000 Тогда
		Возврат Формат(М / 1000, "ЧДЦ=1; ЧГ=0") + " km";
	КонецЕсли;
	Возврат Формат(Окр(М), "ЧГ=0") + " m";
КонецФункции

// "1.10" > "1.9": har bir qism son sifatida solishtiriladi. Natija: -1, 0, 1
Функция СравнитьВерсии(А, Б)
	ЧА = СтрРазделить(А, ".", Ложь);
	ЧБ = СтрРазделить(Б, ".", Ложь);
	Для Инд = 0 По Макс(ЧА.Количество(), ЧБ.Количество()) - 1 Цикл
		ЧислоА = 0;
		ЧислоБ = 0;
		Попытка
			Если Инд < ЧА.Количество() Тогда
				ЧислоА = Число(ЧА[Инд]);
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			Если Инд < ЧБ.Количество() Тогда
				ЧислоБ = Число(ЧБ[Инд]);
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если ЧислоА < ЧислоБ Тогда
			Возврат -1;
		ИначеЕсли ЧислоА > ЧислоБ Тогда
			Возврат 1;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции
